# ─────────────────────────────────────────────────────────────────────────────
# Vela admin + public config API — environment variables.
# Copy to `.env` (never commit `.env`). This file contains NO secrets.
# ─────────────────────────────────────────────────────────────────────────────

# development | staging | production
#  - staging/production: session cookie gets `Secure`, HSTS is sent, REPORT_IP_SALT is mandatory.
APP_ENV=development

# PostgreSQL connection string (Prisma) for running on the host (npm run dev / start / tests).
# Under docker compose this is OVERRIDDEN and built from the POSTGRES_* values below (host `db`).
DATABASE_URL="postgresql://vela:CHANGE_ME@localhost:5432/vela?schema=public"

# Used by docker-compose.yml (Postgres container + DATABASE_URL inside compose).
# Use a long random URL-safe password (letters/digits/-/_ only, it is embedded in a URL).
POSTGRES_USER=vela
POSTGRES_PASSWORD=
POSTGRES_DB=vela
# Host port for the admin container (bound to 127.0.0.1).
ADMIN_PORT=3000

# Ed25519 private key, PKCS#8 DER, base64 (single line). Generate with: npm run keys:generate
# Without it /api/v1/config returns 503 and the dashboard shows "Signing key configured: No".
CONFIG_SIGNING_PRIVATE_KEY=

# Key id placed in the envelope (`keyId`). Bump (k2, k3...) when rotating keys.
CONFIG_SIGNING_KEY_ID=k1

# Secret salt for HMAC-hashing app users' IPs for the report rate limit (≥ 16 chars, random).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REPORT_IP_SALT=

# Public origin of this server, e.g. https://admin.example.com
# Used for the Origin check of admin state-changing requests (in addition to the Host header).
PUBLIC_BASE_URL=http://localhost:3000

# Only for `npm run config:verify` (ops CLI) — the raw base64url public key printed by keys:generate.
CONFIG_PUBLIC_KEY=

# Only for `npm run admin:create-owner` in non-interactive environments (CI). Leave empty locally.
ADMIN_PASSWORD=

# Note: SESSION_SECRET is NOT used. Session tokens are random 256-bit values; only their SHA-256 is stored.

# --- "Remove app ads" subscription verification (POST /api/v1/entitlements/verify) ---
# Without these the endpoint answers 501 not_configured and the app never grants ad-free.
# Comma-separated store product ids that remove app ads (must match the store and the app build).
ENTITLEMENT_PRODUCT_IDS=
# Google Play: package name + base64 of the service-account JSON key that has
# "View financial data" access in Play Console. Never commit the JSON.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# App Store: bundle id. StoreKit 2 transactions are verified offline against Apple Root CA - G3.
# Sandbox transactions are accepted only when APP_ENV is not production.
APPLE_BUNDLE_ID=
