{
  "name": "vela-admin",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "admin:create-owner": "tsx scripts/create-owner.ts",
    "config:verify": "tsx scripts/verify-config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.31",
    "deepmerge-ts": "8.0.2"
  }
}
